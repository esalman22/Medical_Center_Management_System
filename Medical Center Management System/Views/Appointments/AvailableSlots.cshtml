@model IEnumerable<Medical_Center_Management_System.Controllers.DoctorSlotsVM>

@{
    var clinics = ViewBag.Clinics as List<Medical_Center_Management_System.Models.Clinic>
                  ?? new List<Medical_Center_Management_System.Models.Clinic>();
    int? selectedClinic = ViewBag.SelectedClinic;
}
@{
    ViewData["Title"] = "Book an Appointment";
    var selectedDate = (DateTime)ViewBag.SelectedDate;
    var totalSlots = Model.Sum(d => d.AvailableSlots.Count);
}

<div class="page-header">
    <div>
        <h1>Book an Appointment</h1>
        <p>Choose a date, pick a doctor and select a time slot</p>
    </div>
</div>

<!-- ============================================================ -->
<!-- DATE NAVIGATION BAR                                          -->
<!-- ============================================================ -->
<div class="data-table-wrapper" style="margin-bottom:16px; padding:16px 20px;">
    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">

        <!-- Prev day -->
        @if (selectedDate > DateTime.Today)
        {
                <a asp-action="AvailableSlots"
                   asp-route-date="@selectedDate.AddDays(-1).ToString("yyyy-MM-dd")"
                   asp-route-clinicId="@selectedClinic"
                   style="display:flex; align-items:center; justify-content:center;
                width:34px; height:34px; border:1px solid var(--color-border);
                border-radius:var(--radius-md); background:var(--color-surface);
                color:var(--color-text-2); text-decoration:none;
                transition:all var(--transition);"
                   onmouseover="this.style.background='var(--color-primary-light)'; this.style.color='var(--color-primary)';"
                   onmouseout="this.style.background='var(--color-surface)'; this.style.color='var(--color-text-2)';">
                    <i class="fa-solid fa-chevron-left" style="font-size:12px;"></i>
                </a>
        }
        else
        {
                <div style="width:34px; height:34px; border-radius:var(--radius-md);
                background:var(--color-surface-2); display:flex;
                align-items:center; justify-content:center; opacity:.4;">
                    <i class="fa-solid fa-chevron-left" style="font-size:12px; color:var(--color-text-3);"></i>
                </div>
        }

        <!-- 7-day strip -->
        <div style="display:flex; gap:6px; flex:1; flex-wrap:wrap;">
            @for (int d = 0; d < 7; d++)
            {
                var day = DateTime.Today.AddDays(d);
                var isSelected = day.Date == selectedDate.Date;
                var isToday = day.Date == DateTime.Today;
                    <a asp-action="AvailableSlots"
                       asp-route-date="@day.ToString("yyyy-MM-dd")"
                       asp-route-clinicId="@selectedClinic"
                       style="flex:1; min-width:60px; padding:10px 6px; text-align:center;
                    border-radius:var(--radius-md); text-decoration:none;
                    border:1px solid @(isSelected ? "var(--color-primary)" : "var(--color-border)");
                    background:@(isSelected ? "var(--color-primary)" : "var(--color-surface)");
                    color:@(isSelected ? "white" : "var(--color-text-2)");
                    transition:all var(--transition);">
                        <div style="font-size:10px; text-transform:uppercase; letter-spacing:.06em; margin-bottom:3px;
                        color:@(isSelected ? "rgba(255,255,255,.75)" : "var(--color-text-3)");">
                        @day.ToString("ddd")
                        </div>
                        <div style="font-size:16px; font-weight:700;">@day.Day</div>
                    @if (isToday && !isSelected)
                    {
                                <div style="width:4px; height:4px; border-radius:50%; background:var(--color-primary); margin:3px auto 0;"></div>
                    }
                    </a>
            }
        </div>

        <!-- Next day -->
        <a asp-action="AvailableSlots"
           asp-route-date="@selectedDate.AddDays(1).ToString("yyyy-MM-dd")"
           asp-route-clinicId="@selectedClinic"
           style="display:flex; align-items:center; justify-content:center;
            width:34px; height:34px; border:1px solid var(--color-border);
            border-radius:var(--radius-md); background:var(--color-surface);
            color:var(--color-text-2); text-decoration:none; transition:all var(--transition);"
           onmouseover="this.style.background='var(--color-primary-light)'; this.style.color='var(--color-primary)';"
           onmouseout="this.style.background='var(--color-surface)'; this.style.color='var(--color-text-2)';">
            <i class="fa-solid fa-chevron-right" style="font-size:12px;"></i>
        </a>

        <!-- Custom date picker -->
        <form asp-action="AvailableSlots" method="get" style="display:flex; gap:8px; align-items:center;">
            <input type="date" name="date"
                   class="form-control-med"
                   value="@selectedDate.ToString("yyyy-MM-dd")"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                   style="width:160px;" />
            <button type="submit" class="btn-secondary-med">
                <i class="fa-solid fa-arrow-right" style="font-size:11px;"></i>
            </button>
        </form>
    </div>
</div>

<div class="data-table-wrapper"
     style="margin-bottom:16px; padding:16px 20px;">

    <form asp-action="AvailableSlots"
          method="get"
          style="display:flex; gap:12px; align-items:end; flex-wrap:wrap;">

        <!-- Keep selected date -->
        <input type="hidden"
               name="date"
               value="@selectedDate.ToString("yyyy-MM-dd")" />

        <div style="display:flex; flex-direction:row; gap:12px;">

            <div>
                <label style="font-size:12px; margin-bottom:6px; display:block;">
                    Search Doctor
                </label>
                <div class="search-box" style="width:400px;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" name="search"
                           value="@ViewBag.Search"
                           placeholder="Doctor name..." />
                </div>
            </div>

            <div>
                <label style="font-size:12px; margin-bottom:6px; display:block;">
                    Filter by Clinic
                </label>

                <select name="clinicId"
                        class="form-control-med"
                        style="width:220px; height:36px;">

                    <option value="">All Clinics</option>

                    @foreach (var clinic in clinics)
                    {
                            <option value="@clinic.ClinicId"
                                    selected="@(selectedClinic == clinic.ClinicId)">
                            @clinic.Name
                            </option>
                    }

                </select>
            </div>
        </div>

        <button type="submit" class="btn-primary-med">
            <i class="fa-solid fa-filter"></i>
            Apply Filter
        </button>

    </form>

</div>

<!-- Summary -->
<div style="font-size:13.5px; color:var(--color-text-2); margin-bottom:16px; display:flex; align-items:center; gap:10px;">
    <i class="fa-regular fa-calendar" style="color:var(--color-primary);"></i>
    <span>
        <strong style="color:var(--color-text-1);">@selectedDate.ToString("dddd, MMMM dd yyyy")</strong>
        &nbsp;·&nbsp;
        @if (totalSlots > 0)
        {
                <span style="color:#1D9E75; font-weight:600;">@totalSlots slot(s) available</span>
        }
        else
        {
                <span style="color:var(--color-danger-text); font-weight:600;">No slots available</span>
        }
    </span>
</div>

<!-- ============================================================ -->
<!-- SLOTS PER DOCTOR                                              -->
<!-- ============================================================ -->
@if (totalSlots == 0)
{
        <div class="data-table-wrapper">
            <div class="empty-state">
                <div class="empty-state-icon"><i class="fa-solid fa-calendar-xmark"></i></div>
                <h3>No available slots</h3>
                <p>Try a different date using the calendar above.</p>
            </div>
        </div>
}
else
{
    @foreach (var item in Model.Where(d => d.AvailableSlots.Any()))
    {
        var initials = string.Join("", item.Doctor.FullName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2).Select(w => w[0].ToString().ToUpper()));

                <div class="data-table-wrapper" style="margin-bottom:16px;">

                    <!-- Doctor header -->
                    <div style="padding:16px 20px; border-bottom:1px solid var(--color-border);
                display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
                        <div style="width:44px; height:44px; border-radius:50%;
                    background:var(--color-primary-light); color:var(--color-primary-dark);
                    display:flex; align-items:center; justify-content:center;
                    font-size:15px; font-weight:700; flex-shrink:0;">
                    @initials
                        </div>
                        <div style="flex:1;">


                            <div style="font-weight:600; font-size:14px; display:flex; align-items:center; gap:8px;">
                        @item.Doctor.FullName
                        @{
                            var qual = item.Doctor.YearsOfExperience >= 10 ? "Consultant"
                                     : item.Doctor.YearsOfExperience >= 5 ? "Specialist"
                                     : "Resident";
                            var qualClass = item.Doctor.YearsOfExperience >= 10 ? "badge-confirmed"
                                          : item.Doctor.YearsOfExperience >= 5 ? "badge-completed"
                                          : "badge-pending";
                        }
                                <span class="badge-status @qualClass" style="font-size:11px;">@qual</span>
                            </div>


                            <div style="font-size:12px; color:var(--color-text-3); margin-top:3px; display:flex; gap:10px; flex-wrap:wrap;">
                                <span>
                                    <span class="badge-status badge-completed" style="font-size:11px;">
                                        <i class="fa-solid fa-stethoscope" style="font-size:9px;"></i>
                                @item.Doctor.Specialty?.Description
                                    </span>
                                </span>
                                <span>
                                    <i class="fa-solid fa-hospital" style="margin-right:3px;"></i>
                            @item.Doctor.Clinic?.Name
                                </span>
                                <span>
                                    <i class="fa-regular fa-clock" style="margin-right:3px;"></i>
                            @item.Doctor.Clinic?.StartTime.ToString(@"hh\:mm") – @item.Doctor.Clinic?.EndTime.ToString(@"hh\:mm")
                                </span>
                                <span style="color:#1D9E75; font-weight:600;">
                            @item.AvailableSlots.Count slot(s) open
                                </span>
                            </div>
                        </div>
                        <div style="font-size:12px; color:var(--color-text-3);">
                    @item.Doctor.YearsOfExperience yr@(item.Doctor.YearsOfExperience == 1 ? "" : "s") experience
                        </div>
                    </div>

                    <!-- Slot grid -->
                    <div style="padding:16px 20px; display:flex; flex-wrap:wrap; gap:8px;">
                @foreach (var slot in item.AvailableSlots)
                {
                                            <a asp-action="Create"
                                   asp-route-doctorId="@item.Doctor.DoctorId"
                                   asp-route-clinicId="@item.Doctor.ClinicId"
                                   asp-route-dateTime="@slot.ToString("yyyy-MM-ddTHH:mm:ss")"
                                   style="display:inline-flex; align-items:center; gap:6px;
                        padding:9px 18px; border:1px solid var(--color-border);
                        border-radius:var(--radius-md); background:var(--color-surface);
                        font-family:var(--font-mono); font-size:13px; font-weight:500;
                        color:var(--color-text-1); text-decoration:none;
                        transition:all var(--transition);"
                                   onmouseover="this.style.background='var(--color-primary)';
                        this.style.borderColor='var(--color-primary)';
                        this.style.color='white';"
                                   onmouseout="this.style.background='var(--color-surface)';
                        this.style.borderColor='var(--color-border)';
                        this.style.color='var(--color-text-1)';">
                                    <i class="fa-regular fa-clock" style="font-size:11px;"></i>
                        @slot.ToString("HH:mm")
                                </a>
                }
                    </div>

                </div>
    }
}
