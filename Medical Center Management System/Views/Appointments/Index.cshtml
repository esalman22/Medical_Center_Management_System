@model Medical_Center_Management_System.ViewModels.PaginatedList<Medical_Center_Management_System.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
    var currentSearch = Context.Request.Query["search"].ToString();
    var currentStatus = Context.Request.Query["status"].ToString();
    var currentSortOrder = Context.Request.Query["sortOrder"].ToString();
}

<div class="page-header">
    <div>
        <h1>Appointments</h1>
        <p>Manage and track all clinic appointments</p>
    </div>
    <a asp-action="Create" class="btn-primary-med">
        <i class="fa-solid fa-plus"></i> Book Appointment
    </a>
</div>

<!--Added BY Rokia-->
<!--button of Available Appointment-->
<form asp-action="AvailableSlots" asp-controller="Appointments" method="get">
    <button type="submit" class="btn-primary-med" style="margin-bottom: 10px;">
        Available Appointments 
    </button>
</form>

<!--END-->
<div class="data-table-wrapper">
    <div class="data-table-toolbar" style="flex-wrap:wrap;">

        <!-- Search & Filters -->
        <div class="data-table-wrapper">
            <form method="get" asp-action="Index">
                <div class="data-table-toolbar" style="flex-wrap:wrap; gap:10px;">

                    <div class="search-box" style="flex:1; min-width:800px;">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" name="search" value="@currentSearch"
                               placeholder="Search patient, doctor or clinic..." />
                    </div>

                    <div class="table-filters">
                        <!-- Status filter -->
                        <select name="status" class="filter-select">
                            <option value="">All Statuses</option>
                            @foreach (var s in new[] { "Confirmed", "Pending", "Cancelled", "Completed", "Needs Follow Up" })
                            {
                                <option value="@s" selected="@(currentStatus == s)">@s</option>
                            }
                        </select>

                        <!-- Sort -->
                        <select name="sortOrder" class="filter-select">
                            <option value="">Sort by Default</option>
                            <option value="date_asc" selected="@(currentSortOrder == "date_asc")">Date ↑</option>
                            <option value="date_desc" selected="@(currentSortOrder == "date_desc")">Date ↓</option>
                            <option value="doctor" selected="@(currentSortOrder == "doctor")">Doctor</option>
                            <option value="patient" selected="@(currentSortOrder == "patient")">Patient</option>
                            <option value="clinic" selected="@(currentSortOrder == "clinic")">Clinic</option>
                            <option value="status" selected="@(currentSortOrder == "status")">Status</option>
                        </select>

                        <button type="submit" class="btn-primary-med">
                            <i class="fa-solid fa-filter"></i> Apply
                        </button>

                        @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentStatus) || !string.IsNullOrEmpty(currentSortOrder))
                        {
                            <a asp-action="Index" class="btn-secondary-med">
                                <i class="fa-solid fa-xmark"></i> Clear
                            </a>
                        }
                    </div>
                </div>
            </form>
        </div>

    </div>

    <!-- Table -->
    <div style="padding:12px 16px; border-bottom:1px solid var(--color-border); display:flex; justify-content:space-between; align-items:center;">
        <span style="font-size:12.5px; color:var(--color-text-3);">
            <strong style="color:var(--color-text-1);">@Model.TotalItems</strong> appointments found
        </span>
        <div style="display:flex; gap:8px;">
            @{
                var statusCounts = Model.GroupBy(a => a.Status).ToDictionary(g => g.Key, g => g.Count());
            }
            @foreach (var sc in statusCounts)
            {
                var cls = sc.Key?.ToLower() switch
                {
                    "confirmed" => "badge-confirmed",
                    "pending" => "badge-pending",
                    "cancelled" => "badge-cancelled",
                    "completed" => "badge-completed",
                    "needs follow up" => "badge-followup",
                    _ => "badge-pending"
                };
                <span class="badge-status @cls">@sc.Value @sc.Key</span>
            }
        </div>
    </div>

    @if (Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Clinic</th>
                    <th>Date & Time</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = ((Model.PageIndex - 1) * Model.PageSize) + 1;
                }
                @foreach (var item in Model)
                {
                    var statusClass = item.Status?.ToLower() switch
                    {
                        "confirmed" => "badge-confirmed",
                        "pending" => "badge-pending",
                        "cancelled" => "badge-cancelled",
                        "completed" => "badge-completed",
                        "needs follow up" => "badge-followup",
                        _ => "badge-pending"
                    };

                    var isToday = item.AppointmentDate.Date == DateTime.Today;
                    var isPast = item.AppointmentDate.Date < DateTime.Today;
                    var rowStyle = isToday ? "background:#F0FDF4;" : "";

                    <tr style="@rowStyle">
                        <td style="color:var(--color-text-3); font-size:12px;">@i</td>
                        <td>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <div style="width:30px; height:30px; border-radius:50%; background:var(--color-primary-light); color:var(--color-primary-dark); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:600; flex-shrink:0;">
                                    @(item.Patient?.FullName?.Split(' ').Take(2).Select(w => w[0].ToString().ToUpper()).Aggregate("", (a, b) => a + b) ?? "?")
                                </div>
                                <span style="font-weight:500;">@item.Patient?.FullName</span>
                            </div>
                        </td>
                        <td style="color:var(--color-text-2);">@item.Doctor?.FullName</td>
                        <td style="color:var(--color-text-2);">@item.Clinic?.Name</td>
                        <td>
                            <div style="font-family:var(--font-mono); font-size:12.5px;">
                                @item.AppointmentDate.ToString("MMM dd, yyyy")
                            </div>
                            <div style="font-size:11.5px; color:var(--color-text-3);">
                                @item.AppointmentDate.ToString("HH:mm")
                                @if (isToday)
                                {
                                    <span style="color:var(--color-primary); font-weight:600; margin-left:4px;">· Today</span>
                                }
                                else if (isPast)
                                {
                                    <span style="color:var(--color-text-3); margin-left:4px;">· Past</span>
                                }
                            </div>
                        </td>
                        <td><span class="badge-status @statusClass">@item.Status</span></td>
                        <td>
                            <div class="table-actions">
                                <a asp-action="Details" asp-route-id="@item.AppointmentId"
                                   class="btn-action btn-action-view">
                                    <i class="fa-solid fa-eye"></i> View
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.AppointmentId"
                                   class="btn-action btn-action-edit">
                                    <i class="fa-solid fa-pen"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.AppointmentId"
                                   class="btn-action btn-action-delete">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <div style="display:flex; justify-content:center; align-items:center; gap:8px; padding:18px;">

                @if (Model.HasPreviousPage)
                {
                    <a class="btn-secondary-med"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageIndex - 1)"
                       asp-route-search="@Context.Request.Query["search"]"
                       asp-route-status="@Context.Request.Query["status"]"
                       asp-route-sortOrder="@Context.Request.Query["sortOrder"]">
                        Previous
                    </a>
                }
                else
                {
                    <span class="btn-secondary-med" style="opacity:0.5; pointer-events:none;">
                        Previous
                    </span>
                }

                <span style="font-size:14px; color:var(--color-text-2);">
                    Page @Model.PageIndex of @Model.TotalPages
                </span>

                @if (Model.HasNextPage)
                {
                    <a class="btn-secondary-med"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageIndex + 1)"
                       asp-route-search="@Context.Request.Query["search"]"
                       asp-route-status="@Context.Request.Query["status"]"
                       asp-route-sortOrder="@Context.Request.Query["sortOrder"]">
                        Next
                    </a>
                }
                else
                {
                    <span class="btn-secondary-med" style="opacity:0.5; pointer-events:none;">
                        Next
                    </span>
                }

            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon"><i class="fa-regular fa-calendar-xmark"></i></div>
            <h3>No appointments found</h3>
            <p>Try adjusting your filters or book a new appointment.</p>
            <a asp-action="Create" class="btn-primary-med" style="margin-top:14px; display:inline-flex;">
                <i class="fa-solid fa-plus"></i> Book Appointment
            </a>
        </div>
    }
</div>