@model Medical_Center_Management_System.Models.Appointment

@{
    ViewData["Title"] = "Appointment Details";
    var statusClass = Model.Status?.ToLower() switch
    {
        "confirmed" => "badge-confirmed",
        "pending" => "badge-pending",
        "cancelled" => "badge-cancelled",
        "completed" => "badge-completed",
        "needs follow up" => "badge-followup",
        _ => "badge-pending"
    };
    var isToday = Model.AppointmentDate.Date == DateTime.Today;
    var isPast = Model.AppointmentDate.Date < DateTime.Today;
    var isFuture = Model.AppointmentDate.Date > DateTime.Today;

    var patientInitials = Model.Patient?.FullName != null
        ? string.Join("", Model.Patient.FullName.Split(' ').Take(2).Select(w => w[0].ToString().ToUpper()))
        : "?";
    var doctorInitials = Model.Doctor?.FullName != null
        ? string.Join("", Model.Doctor.FullName.Split(' ').Take(2).Select(w => w[0].ToString().ToUpper()))
        : "?";
}

<div class="page-header">
    <div>
        <h1>Appointment Details</h1>
        <p>Full information for this appointment</p>
    </div>
    <a href="javascript:history.back()" class="btn-secondary-med">
        <i class="fa-solid fa-arrow-left"></i> Back
    </a>
</div>

<div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-lg); padding:20px 24px; margin-bottom:16px; box-shadow:var(--shadow-sm); display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
    <div style="width:48px; height:48px; border-radius:var(--radius-md); background:var(--color-primary-light); color:var(--color-primary); display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0;">
        <i class="fa-solid fa-calendar-check"></i>
    </div>
    <div style="flex:1;">
        <div style="font-size:18px; font-weight:700; color:var(--color-text-1);">
            Appointment #@Model.AppointmentId
        </div>
        <div style="font-size:13px; color:var(--color-text-3); margin-top:4px; display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
            <span><i class="fa-regular fa-calendar" style="margin-right:4px;"></i>@Model.AppointmentDate.ToString("dddd, MMMM dd yyyy")</span>
            <span><i class="fa-regular fa-clock" style="margin-right:4px;"></i>@Model.AppointmentDate.ToString("HH:mm")</span>
            @if (isToday)
            {
                <span style="color:var(--color-primary); font-weight:600;">
                    <i class="fa-solid fa-circle" style="font-size:8px; margin-right:4px;"></i>Today
                </span>
            }
            else if (isPast)
            {
                <span style="color:var(--color-text-3);">Past appointment</span>
            }
            else
            {
                <span style="color:var(--color-info-text);">
                    In @((Model.AppointmentDate.Date - DateTime.Today).Days) day(s)
                </span>
            }
        </div>
    </div>
    <span class="badge-status @statusClass" style="font-size:13px; padding:5px 14px;">@Model.Status</span>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">

    <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-lg); padding:18px; box-shadow:var(--shadow-sm);">
        <div style="font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; color:var(--color-text-3); margin-bottom:12px;">Patient</div>
        <div style="display:flex; align-items:center; gap:12px;">
            <div style="width:44px; height:44px; border-radius:50%; background:var(--color-primary-light); color:var(--color-primary-dark); display:flex; align-items:center; justify-content:center; font-size:15px; font-weight:700; flex-shrink:0;">
                @patientInitials
            </div>
            <div>
                <div style="font-weight:600; font-size:14px;">@Model.Patient?.FullName</div>
                <div style="font-size:12px; color:var(--color-text-3);">@Model.Patient?.PhoneNumber</div>
            </div>
        </div>
        @if (Model.Patient != null)
        {
            <a href="/Patients/Details/@Model.PatientId" class="btn-secondary-med" style="margin-top:14px; font-size:12px; padding:5px 12px;">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> View Profile
            </a>
        }
    </div>

    <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius-lg); padding:18px; box-shadow:var(--shadow-sm);">
        <div style="font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:0.06em; color:var(--color-text-3); margin-bottom:12px;">Doctor</div>
        <div style="display:flex; align-items:center; gap:12px;">
            <div style="width:44px; height:44px; border-radius:50%; background:#EFF6FF; color:#1E40AF; display:flex; align-items:center; justify-content:center; font-size:15px; font-weight:700; flex-shrink:0;">
                @doctorInitials
            </div>
            <div>
                <div style="font-weight:600; font-size:14px;">@Model.Doctor?.FullName</div>
                <div style="font-size:12px; color:var(--color-text-3);">@Model.Doctor?.Specialty?.Description</div>
            </div>
        </div>
        @if (Model.Doctor != null)
        {
            <a href="/Doctors/Details/@Model.DoctorId" class="btn-secondary-med" style="margin-top:14px; font-size:12px; padding:5px 12px;">
                <i class="fa-solid fa-arrow-up-right-from-square"></i> View Profile
            </a>
        }
    </div>
</div>

<div class="detail-card">
    <div class="detail-card-header">
        <div class="detail-avatar-icon">
            <i class="fa-solid fa-hospital"></i>
        </div>
        <div>
            <div class="detail-title">@Model.Clinic?.Name</div>
            <div class="detail-subtitle">@Model.Clinic?.Address</div>
        </div>
    </div>
    <div class="detail-body">
        <div class="detail-row">
            <div class="detail-label">Clinic Phone</div>
            <div class="detail-value" style="font-family:var(--font-mono);">@Model.Clinic?.PhoneNumber</div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Working Hours</div>
            <div class="detail-value">
                @Model.Clinic?.StartTime.ToString(@"hh\:mm") – @Model.Clinic?.EndTime.ToString(@"hh\:mm")
            </div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Consultation Price</div>
            <div class="detail-value" style="font-weight:600; color:var(--color-primary);">
                @Model.Clinic?.Price.ToString("C")
            </div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Appointment Status</div>
            <div class="detail-value">
                <span class="badge-status @statusClass">@Model.Status</span>
            </div>
        </div>

        @if (Model.History != null)
        {
            <div class="detail-row">
                <div class="detail-label">History Record</div>
                <div class="detail-value">
                    <span class="badge-status badge-confirmed">On file</span>
                    <a href="/Histories/Details/@Model.History.HistoryId"
                           style="font-size:12px; color:var(--color-primary); margin-left:10px;">
                        View History <i class="fa-solid fa-arrow-right" style="font-size:10px;"></i>
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="detail-row">
                <div class="detail-label">History Record</div>
                <div class="detail-value">
                    <span class="badge-status badge-pending">Not recorded yet</span>

                    <a asp-controller="Histories"
                           asp-action="Create"
                           asp-route-appointmentId="@Model.AppointmentId"
                           style="font-size:12px; color:var(--color-primary); margin-left:10px;">
                        Add History <i class="fa-solid fa-plus" style="font-size:10px;"></i>
                    </a>
                </div>
            </div>
        }
    </div>

    <div class="detail-footer">
        <a asp-action="Edit" asp-route-id="@Model.AppointmentId" class="btn-primary-med">
            <i class="fa-solid fa-pen"></i> Edit
        </a>
        <a asp-action="Delete" asp-route-id="@Model.AppointmentId" class="btn-danger-med">
            <i class="fa-solid fa-trash"></i> Delete
        </a>
    </div>
</div>