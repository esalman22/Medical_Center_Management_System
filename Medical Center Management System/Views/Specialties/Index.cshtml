@model Medical_Center_Management_System.ViewModels.PaginatedList<Medical_Center_Management_System.Models.Specialty>

@{
    ViewData["Title"] = "Specialties";
}

<div class="page-header">
    <div>
        <h1>Specialties</h1>
        <p>Manage all medical specialties in the system</p>
    </div>
    <a asp-action="Create" class="btn-primary-med">
        <i class="fa-solid fa-plus"></i> Add Specialty
    </a>
</div>

<div class="data-table-wrapper">
    <div class="data-table-toolbar" style="flex-wrap:wrap">
        <div class="data-table-wrapper">
            <div class="data-table-toolbar" style="flex-wrap:wrap; gap:10px;">
                <div class="search-box" style="flex:1; min-width:700px;">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="searchInput" placeholder="Search Specialties..." />
                </div>
            </div>
        </div>
    </div>
    <div style="padding:12px 16px; border-bottom:1px solid var(--color-border); display:flex; justify-content:space-between; align-items:center;">

        <div style="font-size:12.5px; color:var(--color-text-3);">
            <span id="rowCount">@Model.TotalItems</span> specialties
        </div>
    </div>
    @if (Model.Any())
    {
        <table class="data-table" id="specialtiesTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Doctors</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = ((Model.PageIndex - 1) * Model.PageSize) + 1;
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="color:var(--color-text-3); font-size:12px;">@i</td>
                        <td>
                            <div style="display:flex; align-items:center; gap:10px;">
                                <div style="width:32px; height:32px; border-radius:8px; background:var(--color-primary-light); color:var(--color-primary); display:flex; align-items:center; justify-content:center; font-size:14px; flex-shrink:0;">
                                    <i class="fa-solid fa-stethoscope"></i>
                                </div>
                                <span style="font-weight:500;">@item.Name</span>
                            </div>
                        </td>
                        <td style="color:var(--color-text-2); max-width:320px;">
                            @(item.Description?.Length > 80
                                                ? item.Description.Substring(0, 80) + "…"
                                                : item.Description)
                </td>
                <td>
                    <span class="badge-status badge-confirmed">
                        @item.Doctors.Count() doctors
                    </span>
                </td>
                <td>
                    <div class="table-actions">
                        <a asp-action="Details" asp-route-id="@item.SpecialtyId"
                           class="btn-action btn-action-view" title="View details">
                            <i class="fa-solid fa-eye"></i> View
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.SpecialtyId"
                           class="btn-action btn-action-edit" title="Edit">
                            <i class="fa-solid fa-pen"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.SpecialtyId"
                           class="btn-action btn-action-delete" title="Delete">
                            <i class="fa-solid fa-trash"></i> Delete
                        </a>
                    </div>
                </td>
            </tr>
                        i++;
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <div style="display:flex; justify-content:center; align-items:center; gap:8px; padding:18px;">

                @if (Model.HasPreviousPage)
                {
                    <a class="btn-secondary-med"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageIndex - 1)"
                       asp-route-search="@Context.Request.Query["search"]">
                        Previous
                    </a>
                }
                else
                {
                    <span class="btn-secondary-med" style="opacity:0.5; pointer-events:none;">
                        Previous
                    </span>
                }

                <span style="font-size:14px; color:var(--color-text-2);">
                    Page @Model.PageIndex of @Model.TotalPages
                </span>

                @if (Model.HasNextPage)
                {
                    <a class="btn-secondary-med"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageIndex + 1)"
                       asp-route-search="@Context.Request.Query["search"]">
                        Next
                    </a>
                }
                else
                {
                    <span class="btn-secondary-med" style="opacity:0.5; pointer-events:none;">
                        Next
                    </span>
                }

            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon"><i class="fa-solid fa-stethoscope"></i></div>
            <h3>No specialties found</h3>
            <p>Get started by adding your first medical specialty.</p>
            <a asp-action="Create" class="btn-primary-med" style="margin-top:14px; display:inline-flex;">
                <i class="fa-solid fa-plus"></i> Add Specialty
            </a>
        </div>
    }
</div>


@section Scripts {
    <script>
        const input = document.getElementById('searchInput');
        const rows  = document.querySelectorAll('#specialtiesTable tbody tr');
        const count = document.getElementById('rowCount');

        input.addEventListener('input', () => {
            const q = input.value.toLowerCase();
            let visible = 0;
            rows.forEach(row => {
                const name = row.children[1].innerText.toLowerCase();
                const match = name.includes(q);
                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            count.textContent = visible;
        });
    </script>
}