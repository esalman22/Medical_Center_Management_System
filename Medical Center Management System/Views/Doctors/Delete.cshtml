@model Medical_Center_Management_System.Models.Doctor

@{
    ViewData["Title"] = "Delete Doctor";
    var initials = string.Join("", Model.FullName.Split(' ')
                    .Take(2).Select(w => w[0].ToString().ToUpper()));
}

<div class="page-header">
    <div>
        <h1>Delete Doctor</h1>
        <p>This action cannot be undone</p>
    </div>
    <a href="javascript:history.back()" class="btn-secondary-med">
        <i class="fa-solid fa-arrow-left"></i> Back 
    </a>
</div>

<div class="delete-card">
    <div class="delete-card-header">
        <div class="delete-icon">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div>
            <div class="delete-card-title">Delete "@Model.FullName"?</div>
            <div class="delete-card-subtitle">This doctor will be permanently removed from the system</div>
        </div>
    </div>

    <div class="delete-body">
        <!-- Doctor mini profile -->
        <div style="display:flex; align-items:center; gap:12px; padding:16px 24px; border-bottom:1px solid var(--color-border); background:var(--color-surface-2);">
            <div style="width:44px; height:44px; border-radius:50%; background:var(--color-primary-light); color:var(--color-primary-dark); display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:700; flex-shrink:0;">
                @initials
            </div>
            <div>
                <div style="font-weight:600; font-size:14px;">@Model.FullName</div>
                <div style="font-size:12px; color:var(--color-text-3);">@Model.Specialty?.Description · @Model.Clinic?.Name</div>
            </div>
        </div>

        <div class="detail-row">
            <div class="detail-label">Phone Number</div>
            <div class="detail-value" style="font-family:var(--font-mono);">@Model.PhoneNumber</div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Years of Experience</div>
            <div class="detail-value">@Model.YearsOfExperience years</div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Specialty</div>
            <div class="detail-value">@Model.Specialty?.Description</div>
        </div>
        <div class="detail-row">
            <div class="detail-label">Clinic</div>
            <div class="detail-value">@Model.Clinic?.Name</div>
        </div>
    </div>

    <div class="delete-footer">
        <form asp-action="Delete" method="post" style="display:inline;">
            <input type="hidden" asp-for="DoctorId" />
            <button type="submit" class="btn-danger-med">
                <i class="fa-solid fa-trash"></i> Yes, Delete
            </button>
        </form>
        <a href="javascript:history.back()" class="btn-secondary-med">
            <i class="fa-solid fa-xmark"></i> Cancel
        </a>
    </div>
</div>
