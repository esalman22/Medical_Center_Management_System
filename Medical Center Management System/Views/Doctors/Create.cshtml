@model Medical_Center_Management_System.Models.Doctor

@{
    ViewData["Title"] = "Add Doctor";
}

<div class="page-header">
    <div>
        <h1>Add Doctor</h1>
        <p>Register a new physician in the system</p>
    </div>

    <a href="javascript:history.back()" class="btn-secondary-med">
        <i class="fa-solid fa-arrow-left"></i>
        Back
    </a>
</div>

<div class="form-card">

    <div class="form-card-header">

        <h2>
            <i class="fa-solid fa-user-doctor"
               style="color:var(--color-primary); margin-right:8px;"></i>

            Doctor Information
        </h2>

        <p>
            Fill in the details below to register a new doctor
        </p>

    </div>

    <form asp-action="Create" method="post">

        <div class="form-card-body">

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary-errors">
            </div>


            <!-- ========================= -->
            <!-- Full Name -->
            <!-- ========================= -->

            <div class="form-group-med">

                <label asp-for="FullName">
                    Full Name
                </label>

                <input asp-for="FullName"
                       class="form-control-med"
                       placeholder="e.g. Dr. Ahmed Hassan" />

                <span asp-validation-for="FullName"
                      class="field-validation-error">
                </span>

            </div>


            <!-- ========================= -->
            <!-- Phone & Experience -->
            <!-- ========================= -->

            <div style="display:grid;
                        grid-template-columns:1fr 1fr;
                        gap:16px;">

                <div class="form-group-med">

                    <label asp-for="PhoneNumber">
                        Phone Number
                    </label>

                    <input asp-for="PhoneNumber"
                           class="form-control-med"
                           placeholder="e.g. 01012345678" />

                    <span asp-validation-for="PhoneNumber"
                          class="field-validation-error">
                    </span>

                </div>


                <div class="form-group-med">

                    <label asp-for="YearsOfExperience">
                        Years of Experience
                    </label>

                    <input asp-for="YearsOfExperience"
                           class="form-control-med"
                           type="number"
                           min="0"
                           max="60"
                           placeholder="e.g. 5" />

                    <span asp-validation-for="YearsOfExperience"
                          class="field-validation-error">
                    </span>

                </div>

            </div>


            <!-- ========================= -->
            <!-- Specialty & Clinic -->
            <!-- ========================= -->

            <div style="display:grid;
                        grid-template-columns:1fr 1fr;
                        gap:16px;">

                <!-- Specialty -->

                <div class="form-group-med">

                    <label asp-for="SpecialtyId">
                        Specialty
                    </label>

                    <select asp-for="SpecialtyId"
                            id="SpecialtyId"
                            class="form-control-med"
                            asp-items="ViewBag.SpecialtyId">

                        <option value="">
                            — Select specialty —
                        </option>

                    </select>

                    <span asp-validation-for="SpecialtyId"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- Clinic -->

                <div class="form-group-med">

                    <label>
                        Clinic
                    </label>

                    <!-- Hidden Input -->

                    <input asp-for="ClinicId"
                           type="hidden"
                           id="ClinicId" />

                    <!-- Readonly Text -->

                    <input type="text"
                           id="ClinicName"
                           class="form-control-med"
                           readonly
                           placeholder="Clinic will be selected automatically" />

                    <span asp-validation-for="ClinicId"
                          class="field-validation-error">
                    </span>

                </div>

            </div>

        </div>


        <!-- ========================= -->
        <!-- Footer -->
        <!-- ========================= -->

        <div class="form-card-footer">

            <button type="submit"
                    class="btn-primary-med">

                <i class="fa-solid fa-floppy-disk"></i>

                Save Doctor

            </button>

            <a href="javascript:history.back()"
               class="btn-secondary-med">

                Cancel

            </a>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document
            .getElementById("SpecialtyId")
            .addEventListener("change", function () {

                const specialtyId = this.value;

                const clinicIdInput =
                    document.getElementById("ClinicId");

                const clinicNameInput =
                    document.getElementById("ClinicName");

                if (!specialtyId) {

                    clinicIdInput.value = "";
                    clinicNameInput.value = "";

                    return;
                }

                fetch('/Doctors/GetClinicBySpecialty?specialtyId=' + specialtyId)

                    .then(response => response.json())

                    .then(data => {

                        if (data.success) {

                            clinicIdInput.value =
                                data.clinicId;

                            clinicNameInput.value =
                                data.clinicName;
                        }
                        else {

                            clinicIdInput.value = "";
                            clinicNameInput.value = "";

                            alert(data.message);
                        }

                    })

                    .catch(error => {

                        console.log(error);

                        clinicIdInput.value = "";
                        clinicNameInput.value = "";

                    });

            });

    </script>
}