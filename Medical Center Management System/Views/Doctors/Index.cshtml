@model Medical_Center_Management_System.ViewModels.PaginatedList<Medical_Center_Management_System.Models.Doctor>

@{
    ViewData["Title"] = "Doctors";
}

<div class="page-header">
    <div>
        <h1>Doctors</h1>
        <p>Manage all physicians registered in the system</p>
    </div>
    <a asp-action="Create" class="btn-primary-med">
        <i class="fa-solid fa-plus"></i> Add Doctor
    </a>
</div>

<div class="data-table-wrapper">
    <div class="data-table-toolbar" style="flex-wrap:wrap">


        <div class="data-table-wrapper">
            <form method="get" asp-action="Index">
                <div class="data-table-toolbar" style="flex-wrap:wrap; gap:10px;">

                    <div class="search-box" style="flex:1; min-width:700px;">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" id="searchInput" name="search"
                               value="@Context.Request.Query["search"]"
                               placeholder="Search by name or phone..." />
                    </div>

                    <div class="table-filters">

                        <!-- Sort -->
                        <select name="sortBy" class="filter-select">
                            <option value="">Sort by Default</option>
                            <option value="exp_desc" selected="@(Context.Request.Query["sortBy"] == "exp_desc")">Experience ↑</option>
                            <option value="exp_asc" selected="@(Context.Request.Query["sortBy"] == "exp_asc")">Experience ↓</option>
                            <option value="spec_asc" selected="@(Context.Request.Query["sortBy"] == "spec_asc")">Specialty A-Z</option>
                            <option value="spec_desc" selected="@(Context.Request.Query["sortBy"] == "spec_desc")">Specialty Z-A</option>
                        </select>

                        <!-- Specialty -->
                        <select name="specialtyId" class="filter-select">
                            <option value="">All Specialties</option>
                            @foreach (var item in (SelectList)ViewData["Specialties"])
                            {
                                <option value="@item.Value" selected="@(Context.Request.Query["specialtyId"] == item.Value)">@item.Text</option>
                            }
                        </select>

                        <!-- Clinic -->
                        <select name="clinicId" class="filter-select">
                            <option value="">All Clinics</option>
                            @foreach (var item in (SelectList)ViewData["Clinics"])
                            {
                                <option value="@item.Value" selected="@(Context.Request.Query["clinicId"] == item.Value)">@item.Text</option>
                            }
                        </select>

                        <button type="submit" class="btn-primary-med">
                            <i class="fa-solid fa-filter"></i> Apply
                        </button>

                        @if (!string.IsNullOrEmpty(Context.Request.Query["search"]) ||
                                                !string.IsNullOrEmpty(Context.Request.Query["sortBy"]) ||
                                                !string.IsNullOrEmpty(Context.Request.Query["specialtyId"]) ||
                                                !string.IsNullOrEmpty(Context.Request.Query["clinicId"]))
                        {
                            <a asp-action="Index" class="btn-secondary-med">
                                <i class="fa-solid fa-xmark"></i> Clear
                            </a>
                        }

                    </div>
                </div>
            </form>
        </div>
    </div>
    <!-- END -->
    <div style="padding:12px 16px; border-bottom:1px solid var(--color-border); display:flex; justify-content:space-between; align-items:center;">

        <div style="font-size:12.5px; color:var(--color-text-3);">
            <span id="rowCount">@Model.TotalItems</span> doctors
        </div>
    </div>
    @if (Model.Any())
    {
        <table class="data-table" id="doctorsTable">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Doctor</th>
                    <th>Phone</th>
                    <th>Specialty</th>
                    <th>Clinic</th>
                    <th>Experience</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = ((Model.PageIndex - 1) * Model.PageSize) + 1;
                }
                @foreach (var item in Model)
                {
                    var initials = string.Join("", item.FullName.Split(' ')
                    .Take(2).Select(w => w[0].ToString().ToUpper()));
                    <tr>
                        <td style="color:var(--color-text-3); font-size:12px;">@i</td>
                        <td>
                            <div style="display:flex; align-items:center; gap:10px;">
                                <div style="width:36px; height:36px; border-radius:50%; background:var(--color-primary-light); color:var(--color-primary-dark); display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:600; flex-shrink:0;">
                                    @initials
                                </div>
                                <div>
                                    <div style="font-weight:500;">@item.FullName</div>
                                    <div style="font-size:12px; color:var(--color-text-3);">ID #@item.DoctorId</div>
                                </div>
                            </div>
                        </td>
                        <td style="font-family:var(--font-mono); font-size:13px;">@item.PhoneNumber</td>
                        <td>
                            <span class="badge-status badge-completed">
                                <i class="fa-solid fa-stethoscope" style="font-size:10px;"></i>
                                @item.Specialty?.Description
                            </span>
                        </td>
                        <td style="color:var(--color-text-2);">
                            <i class="fa-solid fa-hospital" style="color:var(--color-text-3); margin-right:4px;"></i>
                            @item.Clinic?.Name
                        </td>
                        <td>
                            @{
                                var expClass = item.YearsOfExperience >= 10 ? "badge-confirmed"
                                : item.YearsOfExperience >= 5 ? "badge-completed"
                                : "badge-pending";
                            }
                            <span class="badge-status @expClass">
                                @item.YearsOfExperience yr@(item.YearsOfExperience == 1 ? "" : "s")
                            </span>
                        </td>
                        <td>
                            <div class="table-actions">
                                <a asp-action="Details" asp-route-id="@item.DoctorId"
                                   class="btn-action btn-action-view" title="View details">
                                    <i class="fa-solid fa-eye"></i> View
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.DoctorId"
                                   class="btn-action btn-action-edit" title="Edit">
                                    <i class="fa-solid fa-pen"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.DoctorId"
                                   class="btn-action btn-action-delete" title="Delete">
                                    <i class="fa-solid fa-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>

        @if (Model.TotalPages > 1)
        {
            <div style="display:flex; justify-content:center; align-items:center; gap:8px; padding:18px;">

                @if (Model.HasPreviousPage)
                {
                    <a class="btn-secondary-med"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageIndex - 1)"
                       asp-route-search="@Context.Request.Query["search"]"
                       asp-route-sortBy="@Context.Request.Query["sortBy"]"
                       asp-route-specialtyId="@Context.Request.Query["specialtyId"]"
                       asp-route-clinicId="@Context.Request.Query["clinicId"]">
                        Previous
                    </a>
                }
                else
                {
                    <span class="btn-secondary-med" style="opacity:0.5; pointer-events:none;">
                        Previous
                    </span>
                }

                <span style="font-size:14px; color:var(--color-text-2);">
                    Page @Model.PageIndex of @Model.TotalPages
                </span>

                @if (Model.HasNextPage)
                {
                    <a class="btn-secondary-med"
                       asp-action="Index"
                       asp-route-pageNumber="@(Model.PageIndex + 1)"
                       asp-route-search="@Context.Request.Query["search"]"
                       asp-route-sortBy="@Context.Request.Query["sortBy"]"
                       asp-route-specialtyId="@Context.Request.Query["specialtyId"]"
                       asp-route-clinicId="@Context.Request.Query["clinicId"]">
                        Next
                    </a>
                }
                else
                {
                    <span class="btn-secondary-med" style="opacity:0.5; pointer-events:none;">
                        Next
                    </span>
                }

            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon"><i class="fa-solid fa-user-doctor"></i></div>
            <h3>No doctors found</h3>
            <p>Get started by adding your first doctor.</p>
            <a asp-action="Create" class="btn-primary-med" style="margin-top:14px; display:inline-flex;">
                <i class="fa-solid fa-plus"></i> Add Doctor
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        const input = document.getElementById('searchInput');
        const rows = document.querySelectorAll('#doctorsTable tbody tr');
        const count = document.getElementById('rowCount');

        input.addEventListener('input', () => {
            const q = input.value.toLowerCase();
            let visible = 0;
            rows.forEach(row => {
                const match = row.textContent.toLowerCase().includes(q);
                row.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            count.textContent = visible;
        });
    </script>
}