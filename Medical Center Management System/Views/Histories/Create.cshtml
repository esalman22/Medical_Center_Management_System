@model Medical_Center_Management_System.Models.History

@{
    ViewData["Title"] = "Add History";
    bool fromPatient = ViewBag.FromPatient == true;
}

<div class="page-header">
    <div>
        <h1>Add Clinical History</h1>
        @if (fromPatient)
        {
            <p>Recording history for <strong>@ViewBag.PatientName</strong></p>
        }
        else
        {
            <p>Record a new clinical history entry for an appointment</p>
        }
    </div>
    @if (fromPatient)
    {
        <a href="/Patients/Details/@ViewBag.PatientId" class="btn-secondary-med">
            <i class="fa-solid fa-arrow-left"></i> Back to Patient
        </a>
    }
    else
    {
        <a asp-action="Index" class="btn-secondary-med">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    }
</div>

@if (fromPatient)
{
    <!-- Patient info banner -->
    <div style="background:var(--color-primary-light); border:1px solid #A7E8CF; border-radius:var(--radius-lg); padding:14px 20px; margin-bottom:20px; display:flex; align-items:center; gap:14px;">
        <div style="width:40px; height:40px; border-radius:50%; background:var(--color-primary); color:white; display:flex; align-items:center; justify-content:center; font-size:15px; font-weight:700; flex-shrink:0;">
            @(((string)ViewBag.PatientName)?.Split(' ').Take(2).Select(w => w[0].ToString().ToUpper()).Aggregate("", (a, b) => a + b))
        </div>
        <div>
            <div style="font-weight:600; color:var(--color-primary-dark); font-size:14px;">@ViewBag.PatientName</div>
            <div style="font-size:12px; color:var(--color-primary); margin-top:2px; font-family:var(--font-mono);">@ViewBag.PatientPhone</div>
        </div>
        <div style="margin-left:auto;">
            <span class="badge-status badge-confirmed">
                <i class="fa-solid fa-filter" style="font-size:10px;"></i> Showing only this patient's appointments
            </span>
        </div>
    </div>
}

<div class="form-card" style="max-width:720px;">
    <div class="form-card-header">
        <h2><i class="fa-solid fa-clock-rotate-left" style="color:var(--color-primary); margin-right:8px;"></i>History Information</h2>
        <p>Fill in the clinical details for this appointment</p>
    </div>

    <form asp-action="Create" method="post">
        <div class="form-card-body">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            @if (fromPatient)
            {
                <!-- Hidden patient id passed through the appointment selection -->
                <input type="hidden" name="PatientId" value="@ViewBag.PatientId" />
            }

            <!-- Appointment dropdown — filtered to this patient if fromPatient -->
            <div class="form-group-med">
                <label asp-for="AppointmentId">Appointment</label>
                <select asp-for="AppointmentId" class="form-control-med" asp-items="ViewBag.AppointmentId">
                    <option value="">— Select appointment —</option>
                </select>
                @if (fromPatient)
                {
                    <div style="font-size:12px; color:var(--color-text-3); margin-top:5px;">
                        <i class="fa-solid fa-circle-info"></i> Only showing appointments for @ViewBag.PatientName without a history record
                    </div>
                }
                <span asp-validation-for="AppointmentId" class="field-validation-error"></span>
            </div>

            <!-- Diagnosis & Treatment -->
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div class="form-group-med">
                    <label asp-for="Diagnosis">Diagnosis</label>
                    <textarea asp-for="Diagnosis" class="form-control-med" rows="3"
                              placeholder="Describe the diagnosis..."></textarea>
                    <span asp-validation-for="Diagnosis" class="field-validation-error"></span>
                </div>
                <div class="form-group-med">
                    <label asp-for="Treatment">Treatment</label>
                    <textarea asp-for="Treatment" class="form-control-med" rows="3"
                              placeholder="Describe the treatment plan..."></textarea>
                    <span asp-validation-for="Treatment" class="field-validation-error"></span>
                </div>
            </div>

            <!-- Doctor Notes -->
            <div class="form-group-med">
                <label asp-for="DoctorNotes">Doctor Notes</label>
                <textarea asp-for="DoctorNotes" class="form-control-med" rows="3"
                          placeholder="Additional notes from the doctor..."></textarea>
                <span asp-validation-for="DoctorNotes" class="field-validation-error"></span>
            </div>

            <!-- Follow Up & Status -->
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div class="form-group-med">
                    <label asp-for="FollowUpDate">Follow Up Date</label>
                    <input asp-for="FollowUpDate" class="form-control-med" type="date" />
                    <span asp-validation-for="FollowUpDate" class="field-validation-error"></span>
                </div>
                <div class="form-group-med">
                    <label asp-for="Status">Status</label>
                    <select asp-for="Status" class="form-control-med">
                        <option value="">— Select status —</option>
                        <option value="Stable">Stable</option>
                        <option value="Improved">Improved</option>
                        <option value="Recovered">Recovered</option>
                        <option value="Completed">Completed</option>
                        <option value="Needs Follow Up">Needs Follow Up</option>
                    </select>
                    <span asp-validation-for="Status" class="field-validation-error"></span>
                </div>
            </div>

            <!-- Checkboxes -->
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; background:var(--color-surface-2); border-radius:var(--radius-md); padding:14px;">
                <div class="form-check-med">
                    <input asp-for="IsFirstVisit" type="checkbox" />
                    <label asp-for="IsFirstVisit">This is the patient's first visit</label>
                </div>
                <div class="form-check-med">
                    <input asp-for="DidTreatmentWork" type="checkbox" />
                    <label asp-for="DidTreatmentWork">Treatment was effective</label>
                </div>
            </div>

        </div>

        <div class="form-card-footer">
            <button type="submit" class="btn-primary-med">
                <i class="fa-solid fa-floppy-disk"></i> Save & Return to Patient
            </button>
            @if (fromPatient)
            {
                <a href="/Patients/Details/@ViewBag.PatientId" class="btn-secondary-med">Cancel</a>
            }
            else
            {
                <a href="javascript:history.back()" class="btn-secondary-med">Cancel</a>
            }
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
